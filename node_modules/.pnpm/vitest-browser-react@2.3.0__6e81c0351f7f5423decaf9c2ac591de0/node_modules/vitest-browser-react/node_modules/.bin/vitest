#!/bin/sh
# Resolve $0 through symlinks so basedir is the shim's real directory.
# Cap hops at the kernel's ELOOP limit so a cycle cannot hang the shim.
#
# A shim runs with node_modules/.bin at the front of PATH, so readlink, sed,
# uname, and printf go through `command -p`, which searches the system default
# path instead. A dependency's bin cannot stand in for one of them and take over
# the shim before it reaches its target. Directories come from `${link%/*}`,
# which needs no helper at all.
link="$0"
# `${link%/*}` needs a separator to strip. A bare name came from a PATH lookup
# and stands for a file in the current directory.
case "$link" in
  */*|*\\*) ;;
  *) link="./$link" ;;
esac
hops=0
while [ -L "$link" ] && [ "$hops" -lt 40 ]; do
  hops=$((hops+1))
  target=$(command -p readlink "$link")
  case "$target" in
    /*) link="$target" ;;
    *)  link="${link%/*}/$target" ;;
  esac
done
basedir=$(command -p printf '%s\n' "$link" | command -p sed -e 's,\\,/,g')
basedir="${basedir%/*}"
basedir_win="$basedir"
exe=""
msys=""

case `command -p uname -a` in
  *CYGWIN*|*MINGW*|*MSYS*)
    if converted=$(command -p cygpath -w "$basedir" 2>/dev/null) && [ -n "$converted" ]; then
      basedir_win="$converted"
    elif command -v cygpath > /dev/null 2>&1; then
      basedir_win=`cygpath -w "$basedir"`
    fi
    exe=".exe"
    msys="true"
  ;;
  *WSL2*)
    if converted=$(command -p wslpath -w "$basedir" 2>/dev/null) && [ -n "$converted" ]; then
      basedir_win="$converted"
      exe=".exe"
    elif command -v wslpath > /dev/null 2>&1; then
      basedir_win="$(wslpath -w "$basedir" 2> /dev/null)"
      if [ $? -ne 0 ] || [ -z "$basedir_win" ]; then
        basedir_win="$basedir"
      else
        exe=".exe"
      fi
    fi
  ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/c/Users/PC/Desktop/Project/node_modules/.pnpm/vitest@4.1.11_@types+node@2_45cb4bfd30daf4c512beaf006d9fad07/node_modules/vitest/node_modules:/mnt/c/Users/PC/Desktop/Project/node_modules/.pnpm/vitest@4.1.11_@types+node@2_45cb4bfd30daf4c512beaf006d9fad07/node_modules:/mnt/c/Users/PC/Desktop/Project/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/c/Users/PC/Desktop/Project/node_modules/.pnpm/vitest@4.1.11_@types+node@2_45cb4bfd30daf4c512beaf006d9fad07/node_modules/vitest/node_modules:/mnt/c/Users/PC/Desktop/Project/node_modules/.pnpm/vitest@4.1.11_@types+node@2_45cb4bfd30daf4c512beaf006d9fad07/node_modules:/mnt/c/Users/PC/Desktop/Project/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../../../vitest/vitest.mjs" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../vitest/vitest.mjs" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node  "$basedir/../../../vitest/vitest.mjs" "$@"
elif [ -n "$exe" ] && command -v node.exe >/dev/null 2>&1; then
  exec node.exe  "$basedir_win/../../../vitest/vitest.mjs" "$@"
else
  exec node  "$basedir/../../../vitest/vitest.mjs" "$@"
fi
